# AnyPay environment. Copy to .env (gitignored) and fill in. One file serves both apps.
# Never commit real values: this repo is public.

# ---------------------------------------------------------------- API (apps/api)
PORT=3000
# Web origins allowed by CORS, comma-separated.
WEB_ORIGIN=http://localhost:5173
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Shows the DEMO banner and the "Simulate offline" toggle (Phase 3).
DEMO_MODE=true

# Open Payments client: AnyPay's own wallet address and developer key (required from Phase 1).
# From wallet.interledger-test.dev: Settings → Developer keys.
CLIENT_WALLET_ADDRESS=
KEY_ID=
# The private key, either as base64 of the PEM file...
PRIVATE_KEY=
# ...or as a path to the key file. *.key and *.pem are gitignored.
PRIVATE_KEY_PATH=

# SSRF allowlist: the only wallet hosts the API will call, comma-separated.
ALLOWED_WALLET_HOSTS=ilp.interledger-test.dev

# Encrypts grant tokens at rest: 32 random bytes, base64. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Postgres connection string (Neon or Supabase free tier), from Phase 2.
DATABASE_URL=

# ---------------------------------------------------------------- Web (apps/web)
# VITE_* values are bundled into the public web app: never put secrets in them.
# In dev the web app proxies /api to the API. Change this only if the API is not on port 3000.
API_PROXY_TARGET=http://localhost:3000
