# AnyPay environment. Copy to .env (gitignored) and fill in. One file serves both apps.
# Never commit real values: this repo is public.

# ---------------------------------------------------------------- API (apps/api)
PORT=3000
# Web origins allowed by CORS, comma-separated.
WEB_ORIGIN=http://localhost:5173
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Shows the DEMO banner and the "Simulate offline" toggle (Phase 3).
DEMO_MODE=true

# Open Payments client: AnyPay's own wallet address and developer key.
# From wallet.interledger-test.dev: Settings → Developer keys, on the AnyPay app's wallet address.
# Only this one key goes here; customer and shop wallets never need a key in AnyPay.
# NEVER paste a private key into this file: it is committed. Put it in .env (gitignored).
CLIENT_WALLET_ADDRESS=https://ilp.interledger-test.dev/your-anypay-app-wallet
KEY_ID=
# The private key, either as base64 of the PEM file (one line)...
PRIVATE_KEY=
# ...or as a path to the key file, relative to the repo root. *.key, *.pem and .secrets/ are gitignored.
PRIVATE_KEY_PATH=

# SSRF allowlist: the only wallet hosts the API will call, comma-separated. Subdomains are
# included, so interledger-test.dev covers ilp.interledger-test.dev and auth.interledger-test.dev.
ALLOWED_WALLET_HOSTS=interledger-test.dev

# Default wallets for `npm run demo:pay` (public addresses, safe to share).
DEMO_CUSTOMER_WALLET=https://ilp.interledger-test.dev/southtest
DEMO_MERCHANT_WALLET=https://ilp.interledger-test.dev/merchanttest

# Encrypts grant tokens at rest: 32 random bytes, base64. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Postgres connection string (Neon or Supabase free tier). Required in production.
# Leave empty locally: the API then keeps its data in an embedded Postgres under DATA_DIR.
DATABASE_URL=
# Local data folder (gitignored), relative to the repo root. Delete it to start from scratch.
DATA_DIR=.data

# How browsers and wallets reach the API. After approving a payment, the customer's wallet sends
# them to PUBLIC_API_URL/api/payments/<id>/callback, so it must be reachable from their phone.
# Testing on a phone over Wi-Fi: use the web app's address (it forwards /api), for example
# http://192.168.1.20:5173, and put the same address first in WEB_ORIGIN. See docs/testing.md.
PUBLIC_API_URL=http://localhost:3000
# Proxy hops in front of the API when hosted (Render, Fly…: 1), so rate limits see real client IPs.
TRUST_PROXY=0

# ---------------------------------------------------------------- Web (apps/web)
# VITE_* values are bundled into the public web app: never put secrets in them.
# In dev the web app proxies /api to the API. Change this only if the API is not on port 3000.
API_PROXY_TARGET=http://localhost:3000
# Production only, when the API has its own domain (https://anypay-api.example.org). Empty: same origin.
VITE_API_URL=
# The wallet provider most customers and shops use: the wallet field asks only for the name after
# $<host>/. Other providers still work with a full address. Empty: ilp.interledger-test.dev
VITE_WALLET_HOST=
