{
  "name": "@anypay/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
