    "seed": "tsx src/cli/seed.ts"
  },
  "dependencies": {
    "@anypay/shared": "*",
    "@electric-sql/pglite": "^0.5.8",
    "@interledger/open-payments": "^7.4.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15"
  }
